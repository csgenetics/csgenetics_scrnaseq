// nf-test execution config for the external scrnaseq pipeline.
// Deliberately does NOT include conf/aws.config (that hardwires the awsbatch
// executor); nf-tests run locally with docker. bin/ scripts are staged onto
// PATH by Nextflow's classic project-bin mechanism, so moduleBinaries is NOT
// needed (and is not enabled).

includeConfig '../../conf/images.config'
includeConfig '../../conf/base.config'

plugins {
    id 'nf-amazon'
}

docker {
    enabled = true
    runOptions = '-u $(id -u):$(id -g)'
}

// Fixtures: committed small fixtures need no credentials. Fixtures referenced on
// the public s3://csgx.public.readonly bucket are read unsigned. CI may supply
// scoped creds via the standard AWS env vars when a private-bucket fixture is used.
aws {
    region = 'us-east-1'
}

process {
    errorStrategy = 'retry'
    maxRetries = 2
}

timeline.enabled = false
report.enabled = false
trace.enabled = false
dag.enabled = false

// Pipeline params the process scripts read directly, pre-set so process tests do
// not need a full run context. Per-test overrides (e.g. mixed_species=true) are
// set in the individual .nf.test files.
params {
    minimum_count_threshold      = 100
    sss_nmer                     = 8
    barcode_pattern              = "CCCCCCCCCCCCC"
    mixed_species                = false
    mitochondria_chromosome      = "MT"
    hsap_mitochondria_chromosome = "GRCh38_MT"
    mmus_mitochondria_chromosome = "GRCm39_MT"
    hsap_gene_prefix             = "GRCh38_"
    mmus_gene_prefix             = "GRCm39_"
    // Base path for nf-test fixtures (string-concatenated in tests, never GString-
    // interpolated, since nf-test resolves "${...}" before Nextflow runs).
    nftest_data_base             = "tests/nf/fixtures"
}

env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
}
