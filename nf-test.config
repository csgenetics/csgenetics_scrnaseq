config {
    // Per-process modules live at modules/local/<name>/main.nf with their
    // tests at modules/local/<name>/tests/<name>.nf.test.
    testsDir "modules/local"
    // NFT_WORKDIR lets a parallel/sharded run give each test its own workdir.
    workDir System.getenv("NFT_WORKDIR") ?: ".nf-test"
    configFile "tests/nf/nextflow.config"
    triggers "nextflow.config", "nf-test.config", "tests/nf/nextflow.config"
}
